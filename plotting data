import pandas as pd
import numpy as np
import plotly.express as px
from sklearn.preprocessing import StandardScaler
import umap
from data_prep import data_frame_1_prepared

# 1. Load data and select your exact 6 features
df = data_frame_1_prepared
feature_cols = ["Attr1", "Attr9", "Attr3", "Attr6", "Attr8", "Attr46"]
X = np.asarray(df[feature_cols],dtype=float)
y = df['class']  # The classification column for KNN

# 2. Scale the data (Mandatory for both KNN and UMAP)
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# 3. Dimensionality reduction for visualization
# We match the metric='euclidean' so UMAP groups points exactly how KNN sees them
reducer = umap.UMAP(n_neighbors=15, min_dist=0.1, metric='euclidean', random_state=42)
X_embedded = reducer.fit_transform(X_scaled)

# 4. Create plotting DataFrame
plot_df = pd.DataFrame(X_embedded, columns=['Dimension 1', 'Dimension 2'])
plot_df['Actual_Class'] = y.astype(str)
##plot_df['KNN_Prediction'] = df['KNN_Predicted'].astype(str)

# 5. Interactive Plotly Scatter Plot
fig = px.scatter(
    plot_df, 
    x='Dimension 1',  
    y='Dimension 2', 
    color='Actual_Class',  
    title='KNN Neighborhood Clustering Map (6-Feature UMAP Projections)',
    labels={'Dimension 1': 'UMAP 1', 'Dimension 2': 'UMAP 2'},
    opacity=0.8,
    template='plotly_white'
)

fig.update_traces(marker=dict(size=6))
fig.show()